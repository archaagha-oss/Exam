# apps/api/.env.example
# Copy to .env and fill in your values

# Database (PostgreSQL)
DATABASE_URL="postgresql://secureexam:changeme@localhost:5432/secureexam"

# Redis (optional in Phase 1)
REDIS_URL="redis://localhost:6379"

# JWT Secrets — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-random-256-bit-hex"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="replace-with-different-random-256-bit-hex"
JWT_REFRESH_EXPIRES_IN="7d"

# App
NODE_ENV="development"
PORT="4000"
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Email (optional in Phase 1 — PINs shown on-screen instead)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@yourschool.edu"

# AI Question Generation (Track B)
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# S3 / Media Storage (Track A)
S3_BUCKET=secureexam-media
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: for MinIO self-hosted
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/secureexam-media
# Default import password for bulk user creation
BULK_IMPORT_DEFAULT_PASSWORD=ChangeMe123!
