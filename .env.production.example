# .env.production.example
# Copy to .env and fill in your values before deploying
# NEVER commit the actual .env file

# ── Database ─────────────────────────────────────────────
POSTGRES_DB=secureexam
POSTGRES_USER=secureexam
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ── JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_GENERATE_64_BYTE_HEX
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_DIFFERENT_64_BYTE_HEX

# ── CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=https://exam.yourschool.edu,https://teacher.yourschool.edu

# ── Email (SendGrid example)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key
EMAIL_FROM=noreply@yourschool.edu

# ── Docker Hub (for CI/CD)
DOCKER_USERNAME=yourdockerusername
DOCKER_PASSWORD=your_docker_pat

# ── Deployment SSH
DEPLOY_HOST=your.server.ip
DEPLOY_USER=deploy
# DEPLOY_SSH_KEY stored in GitHub Secrets, not here
