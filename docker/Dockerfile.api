# docker/Dockerfile.api
# Multi-stage build. Final image runs as a non-root user with only the
# built JS + production node_modules.
FROM node:20-alpine AS base
WORKDIR /app
RUN apk add --no-cache openssl tini wget

# ── Dependencies ──────────────────────────────────────────
FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared-types/package.json ./packages/shared-types/
RUN npm ci --workspace=apps/api --workspace=packages/shared-types

# ── Build ─────────────────────────────────────────────────
FROM deps AS build
COPY apps/api ./apps/api
COPY packages/shared-types ./packages/shared-types
RUN cd apps/api && npx prisma generate
RUN npm run build --workspace=apps/api

# ── Production image ──────────────────────────────────────
FROM base AS runner
ENV NODE_ENV=production

# Create a non-root user
RUN addgroup -S app && adduser -S -G app app

WORKDIR /app

COPY --from=build --chown=app:app /app/node_modules ./node_modules
COPY --from=build --chown=app:app /app/apps/api/dist ./apps/api/dist
COPY --from=build --chown=app:app /app/apps/api/prisma ./apps/api/prisma
COPY --from=build --chown=app:app /app/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=app:app /app/packages ./packages

USER app
WORKDIR /app/apps/api

EXPOSE 4000
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:4000/health/ready || exit 1

# tini PID 1 forwards signals correctly so SIGTERM triggers a graceful shutdown
ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/index.js"]
