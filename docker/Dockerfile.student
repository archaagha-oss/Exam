# docker/Dockerfile.student
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/student/package.json ./apps/student/
COPY packages/shared-types/package.json ./packages/shared-types/
RUN npm install --workspace=apps/student --workspace=packages/shared-types

FROM deps AS build
COPY apps/student ./apps/student
COPY packages/shared-types ./packages/shared-types
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build --workspace=apps/student

FROM nginx:alpine AS runner
COPY --from=build /app/apps/student/dist /usr/share/nginx/html
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
