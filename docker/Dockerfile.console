# docker/Dockerfile.console
#
# Customer-side School Console (cycle 2.0b / D6). Replaces
# Dockerfile.teacher and Dockerfile.admin — both portals collapsed into a
# single role-aware SPA at apps/console.
FROM node:20-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
COPY apps/console/package.json ./apps/console/
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-frontend/package.json ./packages/shared-frontend/
RUN npm ci --workspace=apps/console \
    --workspace=packages/shared-types \
    --workspace=packages/shared-frontend \
    --include-workspace-root

FROM deps AS build
COPY apps/console ./apps/console
COPY packages/shared-types ./packages/shared-types
COPY packages/shared-frontend ./packages/shared-frontend
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build --workspace=apps/console

FROM nginx:alpine AS runner
COPY --from=build /app/apps/console/dist /usr/share/nginx/html
COPY docker/nginx-spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
